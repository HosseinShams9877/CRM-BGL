    "next-themes": "^0.4.6",
    "prisma": "^6.11.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.4",
    "sharp": "^0.35.4",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",

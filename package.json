{
  "name": "bgl-crm",
  "version": "2.58.11",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build --webpack && node scripts/postbuild.mjs",
    "start": "node scripts/start.mjs",
    "postinstall": "prisma generate",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/verify-browser.mjs",

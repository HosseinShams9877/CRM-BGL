model HesabfaReviewItem {
  id        String   @id @default(cuid())
  jobId     String
  itemType   String
  action    String   @default("create")
  data      String   @default("{}")
  status    String   @default("pending")
  createdAt DateTime @default(now())
  @@index([jobId])
  @@index([status])
}

// ============ Hesabfa Read-Only Integration (v2.32.0 / v2.33.0) ============
// One Hesabfa business (apiKey + loginToken) per CRM company — each company
// syncs ITS OWN items/warehouses/inventory. Company → Hesabfa Connection.
// One-way only: Hesabfa → CRM (the client enforces a read-path whitelist).
model HesabfaConnection {
  id             String    @id @default(cuid())
  companyId      String    @unique
  apiKey         String
  loginToken     String
  baseUrl        String    @default("https://api.hesabfa.com/v1")
  active         Boolean   @default(true)
  businessName   String?   // echoed by getBusinessInfo on test-connection
  lastTestAt     DateTime?
  lastTestOk     Boolean?
  lastTestMsg    String?
  lastSyncAt     DateTime?
  lastSyncStats  String    @default("{}") // JSON summary of the last run
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouseLinks HesabfaWarehouseLink[]
}

// Per-company warehouse notebook: every warehouse discovered during sync is
// recorded here (structural independence — same warehouse code in two
// companies never collides because the key is (companyId, warehouseCode)).
model HesabfaWarehouseLink {
  id            String   @id @default(cuid())
  companyId     String
  warehouseCode String
  warehouseName String
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  connection    HesabfaConnection @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  @@unique([companyId, warehouseCode])
}

// Latest-state inventory snapshot: Company → Warehouse → Item → Quantity.
// warehouseCode "0" carries the TOTAL quantity row (Hesabfa semantics).
// Rewrite-per-company inside one transaction — a failed company never
// corrupts another company's snapshot.
model HesabfaInventorySnapshot {
  id            String   @id @default(cuid())
  companyId     String
  itemCode      String
  itemName      String
  unit          String   @default("")
  warehouseCode String
  warehouseName String   @default("")
  quantity      Float    @default(0)
  fetchedAt     DateTime @default(now())
  @@unique([companyId, itemCode, warehouseCode])
  @@index([companyId, warehouseCode])
  @@index([itemCode])
}

// ═══ v2.57.0 (round 83) — full read/sync cache per upload/حسابفا.txt ═══
// Item catalog cache (Sync کالاها): code, name, unit, prices — the
// snapshot table above carries quantities only, this one the catalog.
model HesabfaItem {
  id           String   @id @default(cuid())
  companyId    String
  itemCode     String   // Hesabfa Code (same key the snapshot uses)
  hesabfaId    Int      @default(0) // Hesabfa numeric Id
  name         String   @default("")
  barCode      String   @default("")
  unit         String   @default("")
  buyPrice     Float    @default(0)
  sellPrice    Float    @default(0) // قیمت فروش (RetrievedSellPrice is not syncable — manual prices only)
  categoryPath String   @default("")
  active       Boolean  @default(true)
  syncedAt     DateTime @default(now())
  @@unique([companyId, itemCode])
  @@index([companyId, active])
}

// Contacts cache (Sync مشتریان) incl. بدهکاری/بستانکاری balance
// (positive = customer owes; negative = prepaid credit).
model HesabfaContact {
  id          String   @id @default(cuid())
  companyId   String
  hesabfaId   Int
  code        String   @default("") // Hesabfa contact Code (legacy key)
  name        String   @default("")
  contactType Int      @default(0) // 1=حقیقی 2=حقوقی 99=جزء … (Hesabfa enums)
  phone       String   @default("")
  mobile      String   @default("")
  email       String   @default("")
  city        String   @default("")
  province    String   @default("")
  address     String   @default("")
  nationalCode String  @default("")
  balance     Float    @default(0) // بدهکاری (+) / بستانکاری (−)
  syncedAt    DateTime @default(now())
  @@unique([companyId, hesabfaId])
  // v2.58.0 (audit 85-c) — code is the manual center-mapping key; duplicates
  // would silently mis-route mapping (verified 0 duplicates before upgrade).
  @@unique([companyId, code])
}

// Invoices cache (Sync فاکتورها) — READ ONLY. Type 0 = فروش, 1 = خرید
// (legacy PHP mapping kept verbatim). Items JSON preserves the full
// line set incl. serials found by the extractor; contact fields are
// denormalized so the list view needs no join. No write path exists —
// creating/editing Hesabfa invoices stays disabled pending approval.
model HesabfaInvoice {
  id            String   @id @default(cuid())
  companyId     String
  hesabfaId     Int
  number        String   @default("") // شماره فاکتور
  invoiceType   Int      @default(0) // 0 = فروش, 1 = خرید
  date          String   @default("") // Jalali YYYY/MM/DD as Hesabfa returns
  contactHesabfaId Int  @default(0)
  contactCode   String   @default("")
  contactName   String   @default("")
  totalAmount   Float    @default(0)
  paidAmount    Float    @default(0)
  description   String   @default("")
  itemsJson     String   @default("[]") // invoice line items (as received)
  serialsJson   String   @default("[]") // serials detected by the extractor
  syncedAt      DateTime @default(now())
  @@unique([companyId, hesabfaId])
  @@index([companyId, invoiceType, date])
  @@index([companyId, contactHesabfaId])
}

// ============ Periodic Follow-ups ============
model PeriodicFollowup {
  id              String   @id @default(cuid())
  companyId       String
  centerId        String?
  centerName      String
  city            String?
  personName      String
  phone           String?
  frequency       String   // weekly, biweekly, monthly, bimonthly
  frequencyDays   Int      @default(30)
  lastFollowupDate String?
  nextFollowupDate String?
  daysOverdue     Int      @default(0)
  totalFollowups  Int      @default(0)
  status          String   @default("upcoming") // overdue, today, upcoming, done
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  company         Company          @relation(fields: [companyId], references: [id])
  center          Center?          @relation(fields: [centerId], references: [id])
  history         FollowupHistory[]
  notes           FollowupNote[]
  @@index([companyId, status])
  @@index([centerId])
}

// ============ Follow-up History ============
model FollowupHistory {
  id            String   @id @default(cuid())
  followupId    String
  followupDate  String
  method        String   // phone, visit, whatsapp, email
  result        String?
  note          String?
  createdAt     DateTime @default(now())
  periodicFollowup PeriodicFollowup @relation(fields: [followupId], references: [id], onDelete: Cascade)
  @@index([followupId])
}

// ============ Follow-up Notes ============
model FollowupNote {
  id         String   @id @default(cuid())
  followupId String
  text       String
  createdAt  DateTime @default(now())
  periodicFollowup PeriodicFollowup @relation(fields: [followupId], references: [id], onDelete: Cascade)
  @@index([followupId])
}

// ════════════════════════════════════════════════════════════
// ═══════════ AI Sales Intelligence (v2.27.0) ════════════════
// هوش مصنوعی فروش و تحلیل مکالمات — تمام داده‌ها Company-Scoped
// ════════════════════════════════════════════════════════════

// ── Call Recording — ورود تماس + Pipeline پردازش ──
// status: uploaded → queued → transcribing → analyzing → completed | failed
model AiCallRecording {
  id              String    @id @default(cuid())
  companyId       String    // company ID (cuid) — tenant isolation, like Center.companyId
  centerId        String?
  contactId       String?
  activityId      String?   // تماس ثبت‌شده مرتبط (Activity.isPhoneCall)
  userId          String?   // کارشناس فروش (گوینده سمت شرکت)
  direction       String    @default("outbound") // inbound | outbound
  source          String    @default("manual-upload") // manual-upload | manual-transcript | telephony
  provider        String    @default("") // telephony provider id (asterisk | 3cx | simotel | …)
  externalId      String?   // شناسهٔ تماس در PBX — idempotency کلید webhook (v2.28.0)
  status          String    @default("uploaded")
  failReason      String    @default("")
  retryCount      Int       @default(0)
  // v2.58.3 (finding 10) — processing lease: claimed workers set a
  // deadline; a crashed worker leaves an EXPIRED lease that the next
  // claim recovers (atomic conditional update, no double processing).
  leaseUntil      DateTime?
  // v2.58.4 (external audit F07) — lease FENCING token: the claim mints
  // a fresh token; every stage write and the final completion are
  // conditional on it. A stale worker whose lease expired (and was
  // re-granted to a newer one) matches ZERO rows on its fenced writes —
  // it can no longer clobber the new owner's state.
  leaseToken      String?
  // v2.58.4 (external audit F07) — per-stage completion markers: a
  // crashed run resumes EXACTLY the remaining stages (an existing
  // action is NOT proof all actions were created; zero actions is a
  // VALID completed result, distinct from "stage never ran").
  actionsDone     Boolean   @default(false)
  memoryDone      Boolean   @default(false)
  coachingDone    Boolean   @default(false)
  audioFileId     String?   // File.id — صوت روی دیسک
  durationSec     Int       @default(0)
  language        String    @default("fa")
  consent         String    @default("unknown") // granted | denied | not-required | unknown
  retentionUntil  DateTime?
  title           String    @default("") // عنوان دلخواه کاربر
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  center          Center?        @relation(fields: [centerId], references: [id])
  contact         CenterContact? @relation(fields: [contactId], references: [id])
  activity        Activity?      @relation(fields: [activityId], references: [id])
  rep             User?          @relation("AiCallRep", fields: [userId], references: [id])
  transcript      AiCallTranscript?
  analyses        AiCallAnalysis[]
  coachInsights   AiCoachInsight[]
  @@index([companyId, status])
  @@index([centerId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@unique([provider, externalId]) // v2.47.0 — webhook idempotency is a CONSTRAINT, not a findFirst race
}

// ── Call Transcript — خروجی STT با Segmentهای گوینده ──
model AiCallTranscript {
  id          String   @id @default(cuid())
  recordingId String   @unique
  sttProvider String   @default("")
  language    String   @default("fa")
  fullText    String   @default("")
  segments    String   @default("[]") // JSON: [{speaker:'rep'|'customer'|'other', startSec, endSec, text}]
  confidence  Float    @default(0)
  wordCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  recording   AiCallRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
}

// ── Call Analysis — استخراج ساختاریافته LLM (Grounded) ──
model AiCallAnalysis {
  id              String   @id @default(cuid())
  recordingId     String
  llmProvider     String   @default("")
  model           String   @default("")
  status          String   @default("completed") // completed | failed
  summary         String   @default("")   // خلاصه تماس
  topic           String   @default("")   // موضوع تماس
  callReason      String   @default("")   // دلیل تماس
  customerNeed    String   @default("")   // نیاز مشتری
  customerProblems String  @default("[]") // JSON: string[]
  products        String   @default("[]") // JSON: [{name, quantity?, note?}]
  budget          String   @default("")
  purchaseTimeframe String @default("")
  intent          String   @default("")  // کلید Intent
  temperature     String   @default("")  // cold | warm | hot | very_hot
  conversionScore Int      @default(0)   // 0-100 — احتمال تبدیل
  scoreReasons    String   @default("[]") // JSON: [{factor, impact:+1|-1, detail}] — Explainability
  objections      String   @default("[]") // JSON: [{type, description, severity, resolved, recommendedResponse}]
  commitments     String   @default("{}") // JSON: {rep: string[], customer: string[]}
  openQuestions   String   @default("[]") // JSON: string[]
  risks           String   @default("[]") // JSON: string[]
  opportunities   String   @default("[]") // JSON: string[]
  paymentTerms    String   @default("")
  competitors     String   @default("[]") // JSON: string[]
  decisionMakers  String   @default("[]") // JSON: [{name?, role?, type: decision_maker|influencer|user|gatekeeper|procurement}]
  suggestedFollowupDate DateTime? // تاریخ پیشنهادی پیگیری (استاندارد میلادی)
  suggestedFollowupReason String @default("")
  stageSuggestion String   @default("")  // پیشنهاد مرحله کاریز
  nextActions     String   @default("[]") // JSON snapshot: [{type, priority, dueAt, reason, confidence}]
  confidence      Float    @default(0)   // اعتبار کلی استخراج
  needsReview     Boolean  @default(false) // Confidence پایین → نیازمند بازبینی انسانی
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  createdAt       DateTime @default(now())
  recording       AiCallRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  coachInsights   AiCoachInsight[]
  @@index([recordingId, createdAt])
}

// ── Customer AI Memory — حافظه ساختاریافته (نه Transcript خام) ──
model AiCustomerMemory {
  id          String   @id @default(cuid())
  companyId   String
  centerId    String
  contactId   String?  // حافظه سطح شخص (اختیاری)
  summary     String   @default("")  // خلاصه رابطه
  preferences String   @default("{}") // JSON: {preferredContactTime, communicationStyle, productInterests[], ...}
  insights    String   @default("{}") // JSON: {purchaseHistory, openObjections[], competitors[], paymentBehavior, decisionMakers[], pastCommitments[], relationshipNotes[]}
  source      String   @default("ai") // ai | manual
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  center      Center        @relation(fields: [centerId], references: [id], onDelete: Cascade)
  contact     CenterContact? @relation(fields: [contactId], references: [id])
  @@index([centerId, contactId])
  @@index([companyId])
}

// ── Next Best Action — با چرخه تأیید انسانی ──
// status: suggested → approved → executed → completed | dismissed
model AiNextAction {
  id            String    @id @default(cuid())
  companyId     String
  centerId      String?
  contactId     String?
  recordingId   String?   // تماس مبدأ
  analysisId    String?
  type          String    // call|whatsapp|email|catalog|price|quotation|demo|meeting|technical_doc|decision_maker|payment|manager|close|mark_lost
  title         String
  detail        String    @default("")
  priority      String    @default("medium") // high | medium | low
  dueAt         DateTime?
  reason        String    @default("")  // Explainability — چرا این اقدام؟
  confidence    Float     @default(0)
  status        String    @default("suggested")
  approvedById  String?
  approvedAt    DateTime?
  executedActivityId String? // Activity ساخته‌شده
  assignedTo    String?
  createdById   String?
  executedAt    DateTime?
  completedAt   DateTime?
  dismissedReason String  @default("")
  // v2.58.4 (external audit F07) — stable per-recording identity
  // ("<recordingId>#<index>"): action creation is RESUMABLE — a crash
  // after the first of three actions re-runs only the missing two
  // (existing keys are skipped; duplicates impossible via the UNIQUE
  // index). NULL for actions not derived from a call (manual).
  dedupeKey     String?    @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  center        Center?        @relation(fields: [centerId], references: [id])
  contact       CenterContact? @relation(fields: [contactId], references: [id])
  assignee      User?          @relation("AiNextActionAssignee", fields: [assignedTo], references: [id])
  @@index([companyId, status])
  @@index([assignedTo, status])
  @@index([dueAt, status])
}

// ── Sales Coach Insight — ارزیابی ۱۳ معیاره هر تماس ──
model AiCoachInsight {
  id             String   @id @default(cuid())
  userId         String   // کارشناس ارزیابی‌شده
  recordingId    String
  analysisId     String?
  qualityScore   Int      @default(0) // 0-100
  scores         String   @default("{}") // JSON: {opening, rapport, needDiscovery, qualification, questionQuality, presentation, listening, objectionHandling, negotiation, closing, nextAction, professionalism, followupQuality} هر یک 0-100
  strengths      String   @default("[]") // JSON: string[]
  improvements   String   @default("[]") // JSON: string[]
  mistakes       String   @default("[]") // JSON: string[]
  recommendations String  @default("[]") // JSON: string[]
  createdAt      DateTime @default(now())
  user           User            @relation(fields: [userId], references: [id])
  recording      AiCallRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  analysis       AiCallAnalysis? @relation(fields: [analysisId], references: [id])
  @@index([userId, createdAt])
}

// ── AI Usage Log — کنترل هزینه ──
model AiUsageLog {
  id                String   @id @default(cuid())
  companyId         String
  userId            String?
  feature           String   // call_analysis | coaching | brief | memory | playbook
  provider          String
  model             String
  inputTokens       Int      @default(0)
  outputTokens      Int      @default(0)
  audioSeconds      Int      @default(0)
  estimatedCostRial Float    @default(0)
  status            String   @default("success") // success | failed
  createdAt         DateTime @default(now())
  @@index([companyId, createdAt])
  @@index([feature, createdAt])
}

// ── Sales Playbook — پلی‌بوک قابل مدیریت ──
model AiPlaybook {
  id                String   @id @default(cuid())
  companyId         String
  category          String   // opening|discovery|qualification|objection|pitch|closing|followup
  title             String
  content           String
  tags              String   @default("[]") // JSON: string[]
  source            String   @default("manual") // manual | winning-mined | ai-suggested
  sourceRecordingId String?
  isActive          Boolean  @default(true)
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@index([companyId, category])
}

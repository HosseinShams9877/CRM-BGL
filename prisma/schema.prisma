// ============ Production Purchase Requests ============
model ProductionPurchaseRequest {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  status      String   @default("pending") // pending, approved, rejected, ordered
  requestedBy String?
  // v2.25.0 — company ownership (nullable): production purchase requests
  // are an internal SHARED queue by design (the production business unit
  // serves the whole holding), so existing rows stay null = visible to
  // every user. The column enables per-company requests if the workflow
  // ever needs them; the route predicate mirrors the optional semantics.
  companyId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company? @relation("PurchaseRequestCompany", fields: [companyId], references: [id])

  @@index([companyId])
}

// ============ Territory ============
model Territory {
  id        String   @id @default(cuid())
  name      String   @unique
  province  String?
  userIds   String   @default("[]") // JSON array
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ Hesabfa Links ============
model HesabfaCenterLink {
  id            String   @id @default(cuid())
  centerId      String   @unique
  hesabfaId     String
  syncedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model HesabfaProductLink {
  id            String   @id @default(cuid())
  productCode   String   @unique
  hesabfaId     String
  syncedAt      DateTime?
  createdAt     DateTime @default(now())
}

model HesabfaJob {
  id        String   @id @default(cuid())
  jobType   String
  status    String   @default("pending")
  companyId String?  // v2.33.0 — independent per-company sync jobs
  payload   String   @default("{}")
  result    String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status])
  @@index([companyId, status])

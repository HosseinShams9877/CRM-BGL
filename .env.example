# ═══════════════════════════════════════════════════════════
# BGL CRM — Environment variables (copy to .env and adjust)
# ═══════════════════════════════════════════════════════════

# SQLite database file (relative to project root)
DATABASE_URL="file:./dev.db"

# Secret used to derive login-attempt throttling keys (HMAC).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED in production.
BGL_HMAC_SECRET=""

# Session cookie "secure" flag.
#   true  → cookie only sent over HTTPS (recommended for production)
#   false → allows plain-HTTP deployments on a trusted LAN
#   unset → defaults to secure only when NODE_ENV=production
COOKIE_SECURE=

# ═══ v2.31.1 — CSRF same-origin trust (middleware layer 2) ═══
# Extra origins allowed for mutating API requests when the app runs behind
# a proxy/tunnel that rewrites the Host header (preview links, cloudflared,
# ngrok, default proxy_pass). Entries (comma-separated) may be:
#   crm.example.com          → exact host
#   https://crm.example.com  → full origin URL
#   *.space-z.ai             → wildcard subdomains
# Leave empty for direct/localhost access or an nginx that preserves Host.
TRUSTED_ORIGINS=""

# ═══ v2.47.0 — rate-limit client IP trust ═══
# Set to "true" ONLY when the app runs behind YOUR OWN reverse proxy /
# tunnel (nginx, cloudflared). Then the proxy-appended (rightmost)
# x-forwarded-for entry and x-real-ip are used to count clients
# individually. Leave unset/false otherwise: a spoofable client-supplied
# XFF header is IGNORED and all direct clients share one bucket —
# brute-force throttling cannot be bypassed by rotating a fake header.
TRUSTED_PROXY=

# ═══ v2.47.0 — snapshot backup directory ═══
# Where /api/backup "snapshot" + scripts/backup-cron.mjs write their
# VACUUM INTO snapshots (default: ./backups).
BGL_BACKUP_DIR=

# Optional: preset the initial admin password when seeding
# (otherwise a random one is generated and printed ONCE).
# Remember to unset it afterwards.
SEED_ADMIN_PASSWORD=

# Optional: also create demo staff users during seed (not recommended for production)
SEED_DEMO_USERS=

# ═══ v2.27.0 — AI Sales Intelligence ═══
# No new ENV is required: the default AI provider (zai) is built in and all
# AI settings (providers, flags, cost caps, retention) are managed from the
# admin UI (تنظیمات هوش مصنوعی) and stored in the Meta table.
# Optional external providers use the existing ai_bridge.* settings.
# STORAGE_DIR (already supported) also hosts call-audio uploads.

# ═══ v2.58.3 — SSRF protection for outbound AI calls ═══
# All outbound requests to ai_bridge endpoints (chat / LLM / STT /
# connection-test) are validated BEFORE connecting: loopback, RFC1918,
# cloud metadata (169.254.169.254) and IPv6 link-local (fe80::/10) are
# refused, DNS answers are all checked, the connection is PINNED to the
# verified IP (no DNS rebinding), redirects are never followed, and one
# deadline covers headers + the whole body.
# If your AI endpoint runs ON THIS SAME MACHINE (local Ollama/vLLM),
# set the explicit switch below to allow loopback + private ranges for
# those calls. Default: OFF (refuse). Link-local and metadata addresses
# are NEVER allowed, even with this switch on.
AI_ALLOW_LOCAL_ENDPOINTS=

# ── Hesabfa inbound webhook (optional) ─────────────────────────
# Set a random secret, then register this URL in Hesabfa settings:
#   https://YOUR-DOMAIN/api/hesabfa/webhook?key=YOUR_SECRET
# (or send it as the X-Hesabfa-Key header). While unset, the
# endpoint rejects everything (fail-closed). Events are stored
# read-only for the admin «رویدادهای وب‌هوک» list.
HESABFA_WEBHOOK_SECRET=

# ═══ v2.57.0 — Hesabfa unit credentials (see حسابفا.txt) ═══
# production → شرکت BGL (slug: bgl) · trading → بازرگانی (slug: bazargani)
HESABFA_PRODUCTION_API_KEY=
HESABFA_PRODUCTION_LOGIN_TOKEN=
HESABFA_PRODUCTION_USER_ID=
HESABFA_TRADING_API_KEY=
HESABFA_TRADING_LOGIN_TOKEN=
HESABFA_TRADING_USER_ID=
HESABFA_BASE_URL=https://api.hesabfa.com/v1

# ═══ v2.58.0 — log file sink ═══
# Set a directory to mirror every structured log line into
# <dir>/bgl-YYYY-MM-DD.log (rotated at 5MB, 14 files kept).
# Strongly recommended for the local Windows package: closing the
# console window no longer destroys support evidence.
# Empty = console-only logging.
BGL_LOG_DIR=
